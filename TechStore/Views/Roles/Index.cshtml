@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Roles";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Roles</h1>

    <form asp-action="Create" method="post" class="d-flex gap-2 mb-4">
        <input name="nombre" class="form-control" placeholder="Nombre del nuevo rol" required />
        <button type="submit" class="btn btn-dark">Crear rol</button>
    </form>

    <table class="table">
        <thead><tr><th>Rol</th><th></th></tr></thead>
        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol.Name</td>
                    <td class="text-end">
                        @if (rol.Name is not ("Admin" or "Vendedor" or "Cliente"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@rol.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
