@model TechStore.Models.Producto
@{
    ViewData["Title"] = "Editar producto";
}

<div class="container py-5" style="max-width: 700px;">
    <h1 class="fw-bold mb-4">Editar producto</h1>

    <form asp-action="Edit" asp-route-id="@Model.ID" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ID" />

        <partial name="_FormularioProducto" model="Model" />

        <button type="submit" class="btn btn-primary rounded-3 px-4">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
