@model TechStore.Models.Producto
@{
    ViewData["Title"] = "Detalles del producto";
}

<div class="container py-5" style="max-width: 700px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <img src="@Model.Imagen" alt="@Model.Nombre" style="height: 260px; object-fit: cover;" />
        <div class="card-body p-4">
            <h2 class="fw-bold mb-3">Detalles del producto @Model.Nombre</h2>

            <dl class="row mb-4">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.Descripcion</dd>

                <dt class="col-sm-4">Categoría</dt>
                <dd class="col-sm-8">@Model.CategoriaEntidad?.Nombre</dd>

                <dt class="col-sm-4">Precio</dt>
                <dd class="col-sm-8">$@Model.Precio.ToString("N2")</dd>

                <dt class="col-sm-4">Stock</dt>
                <dd class="col-sm-8">@Model.Stock</dd>

                <dt class="col-sm-4">Disponibilidad</dt>
                <dd class="col-sm-8">@(Model.Estado && Model.Stock > 0 ? "Disponible" : "Agotado")</dd>
            </dl>

            <a asp-action="Index" class="btn btn-primary rounded-3 px-4">Volver al listado</a>
        </div>
    </div>
</div>
