@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="badge bg-primary px-3 py-2 mb-3">
                TechStore
            </span>

            <h1 class="display-5 fw-bold">
                Nuestros Productos
            </h1>

            <p class="lead text-muted">
                Encuentra tecnología para estudiar, trabajar, jugar y mantenerte conectado.
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var producto in Model)
            {
                <div class="col">
                    <partial name="_ProductCard" model="producto" />
                </div>
            }

        </div>

    </div>
</section>