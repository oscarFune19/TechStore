@model IEnumerable<TechStore.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-dark">Nuestros Productos</h1>
        <p class="text-muted lead">Encuentra tecnología para estudiar, trabajar, jugar y mantenerte conectado.</p>
    </div>

    <!-- Banner informativo si hay un filtro aplicado -->
    @if (ViewData["CategoriaSeleccionada"] != null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4 rounded-3 shadow-sm border-0">
            <div>
                <i class="bi bi-funnel-fill me-2"></i>
                Mostrando productos de la categoría: <strong>@ViewData["CategoriaSeleccionada"]</strong>
            </div>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-sm btn-dark rounded-pill px-3">
                <i class="bi bi-x-circle me-1"></i> Ver todos los productos
            </a>
        </div>
    }

    <!-- Grid de Productos -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden tech-card">
                        <img src="@item.Imagen" class="card-img-top" alt="@item.Nombre" style="height: 220px; object-fit: cover;">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <span class="badge bg-primary mb-2">@item.Categoria</span>
                                <h5 class="card-title fw-bold text-dark">@item.Nombre</h5>
                                <p class="card-text text-muted small mb-3">@item.Descripcion</p>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-4 fw-bold text-primary">$@item.Precio</span>
                                    <span class="small text-muted">Stock: @item.Stock</span>
                                </div>
                                @if (item.Estado && item.Stock > 0)
                                {
                                    <div class="bg-success bg-opacity-10 text-success text-center py-2 rounded-3 fw-bold small">
                                        Disponible
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-danger bg-opacity-10 text-danger text-center py-2 rounded-3 fw-bold small">
                                        Agotado
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                <h4 class="text-muted">No se encontraron productos en esta categoría.</h4>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-primary mt-3 rounded-3">Volver al catálogo completo</a>
            </div>
        }
    </div>
</div>