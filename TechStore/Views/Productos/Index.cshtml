@{
    ViewData["Title"] = "Lista de Productos";
}

<div class="container my-4">
    <h1 class="text-center fw-bold">Productos</h1>
    <p class="text-muted lead text-center">Explora nuestro catálogo de productos disponibles.</p>

    <!-- 1. BOTÓN DE AGREGAR (Debajo del subtítulo) -->
    <div class="text-center mt-3">
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Agregar producto
        </a>
    </div>

    <div class="row mt-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 p-3">
                    <div class="card-body">

                        <!-- 2. BADGE DE CATEGORÍA -->
                        <span class="badge bg-primary mb-2">@item.CategoriaEntidad?.Nombre</span>

                        <h5 class="card-title fw-bold">@item.Nombre</h5>
                        <p class="card-text text-muted">@item.Descripcion</p>

                        <!-- Ejemplo de bloque de Estado y Stock -->
                        @if (item.Estado && item.Stock > 0)
                        {
                            <span class="badge bg-success">Disponible (@item.Stock)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Agotado</span>
                        }

                        <!-- 3. BOTONES DE EDITAR Y ELIMINAR (Justo después del bloque de estado/stock) -->
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm rounded-3 flex-fill">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-danger btn-sm rounded-3 flex-fill">Eliminar</a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>