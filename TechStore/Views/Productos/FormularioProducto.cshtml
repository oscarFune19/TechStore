@model TechStore.Models.Producto

<div class="mb-3">
    <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Precio" class="form-label fw-bold">Precio</label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label fw-bold">Stock</label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
        <option value="">-- Seleccione una categoría --</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Imagen" class="form-label fw-bold">URL de la imagen</label>
    <input asp-for="Imagen" class="form-control" />
    <span asp-validation-for="Imagen" class="text-danger"></span>
</div>

<div class="form-check mb-4">
    <input asp-for="Estado" class="form-check-input" />
    <label asp-for="Estado" class="form-check-label">Producto activo</label>
</div>