@model TechStore.Models.Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <img src="@Model.Imagen" alt="@Model.Nombre" style="height: 200px; object-fit: cover;" />
        <div class="card-body p-4">
            <h2 class="fw-bold text-danger">¿Estás seguro de que deseas eliminar esta categoría?</h2>
            <p class="text-muted">Esta acción no se puede deshacer.</p>

            <dl class="row mb-4">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.Descripcion</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="ID" />

                <button type="submit" class="btn btn-danger rounded-3 px-4">Confirmar Eliminación</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancelar</a>
            </form>
        </div>
    </div>
</div>
