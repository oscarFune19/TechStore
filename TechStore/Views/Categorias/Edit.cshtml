@model TechStore.Models.Categoria
@{
    ViewData["Title"] = "Editar categoría";
}

<div class="container py-5" style="max-width: 700px;">
    <h1 class="fw-bold mb-4">Editar categoría</h1>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ID" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Imagen" class="form-label fw-bold">Imagen (URL)</label>
            <input asp-for="Imagen" class="form-control" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>
        <div class="form-check mb-4">
            <input asp-for="Activa" class="form-check-input" />
            <label asp-for="Activa" class="form-check-label">Activa</label>
        </div>
        <button type="submit" class="btn btn-success rounded-3 px-4">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancelar</a>
    </form>
</div>
