@model IEnumerable<TechStore.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Categorías</h1>
        <p class="text-muted lead">Explora las categorías de productos disponibles en nuestra tienda.</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Vendedor"))
    {
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
            <a asp-action="Create" class="btn btn-dark rounded-pill px-4">
                <i class="bi bi-plus-circle me-1"></i> Agregar categoría
            </a>
            <a asp-action="DescargarReporte" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Reporte
            </a>
            <a asp-action="Reporte" class="btn btn-outline-danger rounded-pill px-4">
                <i class="bi bi-eye me-1"></i> Ver Reporte
            </a>
        </div>
    }

    <div class="row g-4">
        @foreach (var categoria in Model)
        {
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden tech-card">
                    <img src="@categoria.Imagen"
                         class="card-img-top" alt="@categoria.Nombre" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-primary mb-2">@categoria.Nombre</span>
                            <h5 class="card-title fw-bold">@categoria.Nombre</h5>
                            <p class="card-text text-muted small">@categoria.Descripcion</p>
                        </div>
                        <div class="mt-3 d-flex gap-2 justify-content-end">
                            @if (User.IsInRole("Admin") || User.IsInRole("Vendedor"))
                            {
                                <a asp-action="Edit" asp-route-id="@categoria.ID" class="btn btn-outline-secondary btn-sm rounded-3">Editar</a>
                                <a asp-action="Delete" asp-route-id="@categoria.ID" class="btn btn-outline-danger btn-sm rounded-3">Eliminar</a>
                            }
                            <a asp-controller="Productos" asp-action="Index" asp-route-categoria="@categoria.Nombre" class="btn btn-outline-primary btn-sm rounded-3 fw-bold">Ver</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: successMessage,
                timer: 3000,
                showConfirmButton: false
            });
        }
    </script>
}
