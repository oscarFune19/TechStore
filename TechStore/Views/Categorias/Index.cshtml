@model IEnumerable<TechStore.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="badge bg-primary px-3 py-2 mb-3">TechStore</span>
            <h1 class="display-5 fw-bold">Categorías</h1>
            <p class="lead text-muted">Explora las categorías de productos disponibles en nuestra tienda.</p>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var categoria in Model)
            {
                <div class="col d-flex">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden w-100">
                        <img src="@categoria.Imagen"
                             class="card-img-top"
                             alt="@categoria.Nombre"
                             style="height:160px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge @(categoria.Activa ? "bg-primary" : "bg-secondary")">
                                    @categoria.Nombre
                                </span>
                            </div>

                            <h5 class="card-title fw-bold">@categoria.Nombre</h5>

                            <p class="card-text text-muted flex-grow-1">@categoria.Descripcion</p>

                            <div class="mt-3 d-flex justify-content-end">
                                <a asp-controller="Categorias" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>
