@{
    ViewData["Title"] = "Contáctenos";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <h1 class="fw-bold text-primary">Ponte en Contacto</h1>
                <p class="text-muted">¿Tienes dudas sobre nuestros productos tecnológicos? Escríbenos y te responderemos pronto.</p>
            </div>

            <div class="row g-4">
               
                <div class="col-md-7">
                    <div class="card shadow-sm border-0 p-4">
                        <form>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nombre completo</label>
                                <input type="text" class="form-control" placeholder="Ej. Juan Pérez">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Correo electrónico</label>
                                <input type="email" class="form-control" placeholder="nombre@ejemplo.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Asunto</label>
                                <input type="text" class="form-control" placeholder="¿Sobre qué quieres consultar?">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mensaje</label>
                                <textarea class="form-control" rows="4" placeholder="Escribe tu mensaje aquí..."></textarea>
                            </div>
                            <button type="button" class="btn btn-primary w-100 py-2 fw-bold">Enviar mensaje</button>
                        </form>
                    </div>
                </div>

                
                <div class="col-md-5">
                    <div class="card bg-light border-0 p-4 h-100 shadow-sm">
                        <h4 class="fw-bold mb-3 text-dark">Información de contacto</h4>
                        <p class="text-muted mb-4">Estamos ubicados en el corazón de El Salvador para brindarte el mejor servicio tecnológico.</p>

                        <div class="mb-3">
                            <p class="mb-1 fw-bold text-dark">📍 Dirección:</p>
                            <p class="text-muted">San Salvador, El Salvador</p>
                        </div>
                        <div class="mb-3">
                            <p class="mb-1 fw-bold text-dark">✉️ Correo electrónico:</p>
                            <p class="text-muted">info@techstore.com</p>
                        </div>
                        <div class="mb-3">
                            <p class="mb-1 fw-bold text-dark">📞 Teléfono:</p>
                            <p class="text-muted">+503 2200-0000</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>