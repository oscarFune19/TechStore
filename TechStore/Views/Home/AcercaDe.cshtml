@{
    ViewData["Title"] = "Acerca de nosotros";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">Acerca de TechStore</h1>
        <p class="lead text-muted">Innovación, calidad y confianza en cada dispositivo.</p>
    </div>

    <div class="row align-items-center mb-5 bg-light p-4 rounded-3 shadow-sm border">
        <div class="col-lg-12">
            <h3 class="fw-bold mb-3 text-dark">Nuestra Historia</h3>
            <p class="text-muted fs-6 lh-base">
                TechStore nació en El Salvador con la visión clara de transformar la forma en que las personas acceden a la tecnología de vanguardia.
                Comenzamos como un proyecto apasionado y hoy nos consolidamos como un referente en soluciones tecnológicas, ofreciendo una amplia gama
                de productos que se adaptan a las exigencias del mundo moderno y a las necesidades de nuestros clientes.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 p-4 text-center">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">Misión</h4>
                    <p class="text-muted">Proveer soluciones tecnológicas innovadoras y accesibles que potencien la productividad y mejoren la vida diaria de nuestros clientes.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 p-4 text-center">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">Visión</h4>
                    <p class="text-muted">Ser la tienda de tecnología líder y preferida en la región centroamericana, reconocida por su excelencia, servicio y vanguardia en productos.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 p-4 text-center">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">Valores</h4>
                    <ul class="list-unstyled text-muted text-start ps-3">
                        <li class="mb-2">✔️ Innovación constante</li>
                        <li class="mb-2">✔️ Atención al cliente excepcional</li>
                        <li class="mb-2">✔️ Calidad y garantía comprobada</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>