<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Estilos Custom -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Encabezado / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-tech shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill text-primary-tech fs-3"></i>
                    <span>Tech<span class="text-primary-tech">Store</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTechStore" aria-controls="navbarTechStore" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarTechStore">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1 font-weight-medium">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Productos" asp-action="Index"><i class="bi bi-grid-3x3-gap me-1"></i> Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Categorias" asp-action="Index"><i class="bi bi-tags me-1"></i> Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="AcercaDe"><i class="bi bi-info-circle me-1"></i> Acerca de nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Contactenos"><i class="bi bi-envelope me-1"></i> Contáctenos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Área de Contenido Principal -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Pie de Página / Footer -->
    <footer class="bg-dark-tech text-light pt-5 pb-3 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 fw-bold text-white fs-4 mb-3">
                        <i class="bi bi-cpu-fill text-primary-tech fs-3"></i>
                        <span>Tech<span class="text-primary-tech">Store</span></span>
                    </div>
                    <p class="text-secondary small">
                        Tu destino tecnológico de vanguardia. Equipos de alta fidelidad, componentes de última generación y asesoría técnica especializada.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Navegación</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none hover-white">Inicio</a></li>
                        <li><a asp-controller="Productos" asp-action="Index" class="text-secondary text-decoration-none hover-white">Productos</a></li>
                        <li><a asp-controller="Categorias" asp-action="Index" class="text-secondary text-decoration-none hover-white">Categorías</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Empresa</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="AcercaDe" class="text-secondary text-decoration-none hover-white">Acerca de nosotros</a></li>
                        <li><a asp-controller="Home" asp-action="Contactenos" class="text-secondary text-decoration-none hover-white">Contáctenos</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Contacto</h6>
                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2">
                        <li><i class="bi bi-geo-alt text-primary-tech me-2"></i> San Salvador, El Salvador</li>
                        <li><i class="bi bi-envelope text-primary-tech me-2"></i> contacto@techstore.com</li>
                        <li><i class="bi bi-telephone text-primary-tech me-2"></i> +503 2222-0000</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-3" />

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; @DateTime.Now.Year TechStore. Todos los derechos reservados.</p>
                <p class="mb-0">Desarrollado con ASP.NET Core MVC</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>