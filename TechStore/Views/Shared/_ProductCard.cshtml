@model TechStore.Models.Producto

<div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

    <img src="@Model.Imagen"
         class="card-img-top"
         alt="@Model.Nombre"
         style="height: 220px; object-fit: cover;" />

    <div class="card-body d-flex flex-column">

        <div class="mb-2">
            <span class="badge bg-primary">
                @Model.Categoria
            </span>
        </div>

        <h5 class="card-title fw-bold">
            @Model.Nombre
        </h5>

        <p class="card-text text-muted flex-grow-1">
            @Model.Descripcion
        </p>

        <div class="d-flex justify-content-between align-items-center mb-3">

            <span class="fs-4 fw-bold text-primary">
                $@Model.Precio.ToString("N2")
            </span>

            <span class="text-muted">
                Stock: @Model.Stock
            </span>

        </div>

        @if (Model.Estado && Model.Stock > 0)
        {
            <div class="alert alert-success py-2 mb-0 text-center">
                Disponible
            </div>
        }
        else
        {
            <div class="alert alert-secondary py-2 mb-0 text-center">
                Agotado
            </div>
        }

    </div>
</div>