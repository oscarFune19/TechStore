@model ErrorViewModel
@{
    ViewData["Title"] = "Ha ocurrido un problema";
}

<section class="container py-5 text-center" style="max-width: 640px;">
    <div class="fs-1 text-danger mb-2"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <p class="text-danger fw-bold mb-1" style="letter-spacing: .2rem;">500</p>
    <h1 class="display-5 fw-bold">Algo no ha salido como esperábamos</h1>
    <p class="lead text-muted">Se ha producido un problema inesperado. Nuestro equipo ya puede revisarlo. Intenta continuar desde una sección segura.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Código de solicitud: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary">Ver productos</a>
    </div>
</section>
