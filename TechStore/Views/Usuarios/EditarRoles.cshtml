@model EditarRolesUsuarioViewModel
@{
    ViewData["Title"] = "Editar roles";
}

<div class="container py-5" style="max-width: 600px;">
    <h1 class="fw-bold mb-4">Roles de @Model.UserName</h1>
    <form asp-action="EditarRoles" method="post">
        <input type="hidden" asp-for="UserId" />
        @for (var i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check mb-2">
                <input type="hidden" asp-for="Roles[i].Nombre" />
                <input asp-for="Roles[i].Seleccionado" class="form-check-input" />
                <label asp-for="Roles[i].Seleccionado" class="form-check-label">@Model.Roles[i].Nombre</label>
            </div>
        }
        <button type="submit" class="btn btn-primary mt-3">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Cancelar</a>
    </form>
</div>
