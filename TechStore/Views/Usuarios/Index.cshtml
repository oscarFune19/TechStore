@model IEnumerable<UsuarioListadoItem>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Usuarios</h1>
    <table class="table">
        <thead><tr><th>Usuario</th><th>Correo</th><th>Roles</th><th></th></tr></thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.UserName</td>
                    <td>@usuario.Email</td>
                    <td>@string.Join(", ", usuario.Roles)</td>
                    <td class="text-end"><a asp-action="EditarRoles" asp-route-id="@usuario.Id" class="btn btn-outline-primary btn-sm">Editar roles</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
